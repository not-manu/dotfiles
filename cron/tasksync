#!/bin/bash
set -euo pipefail
repo=$HOME/Documents/Projects/not-manu/taskwarrior
cd "$repo"
git add tasks.json
if ! git diff --cached --quiet; then
  git commit -q -m "tasks $(date '+%Y-%m-%d %H:%M')"
  echo "$(date '+%F %T') committed $(git rev-parse --short HEAD)"
fi
[ "$(git rev-list --count '@{u}..HEAD')" -gt 0 ] || exit 0
if gbp --wait >/dev/null; then
  echo "$(date '+%F %T') pushed"
else
  echo "$(date '+%F %T') push failed, see $repo/.git/gbp.log"
  exit 1
fi
