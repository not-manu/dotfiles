data.location=~/.local/share/task
hooks.location=~/.config/task/hooks
confirmation=off
verbose=blank,header,footnote,label,new-id,affected,edit,special,project,sync,unwait
weekstart=monday
dateformat=Y-M-D
dateformat.report=D/M
dateformat.info=Y-M-D H:N
due=7
urgency.due.coefficient=15.0
urgency.blocking.coefficient=6.0
urgency.tags.coefficient=0.0
report.next.columns=id,start.age,depends,priority,project,tags,due.relative,description,urgency
report.next.labels=ID,Active,Deps,P,Project,Tags,Due,Description,Urg
report.next.filter=status:pending -WAITING -BLOCKED -waiting limit:page
report.waiting.description=Waiting on someone else
report.waiting.columns=id,project,who,wait.remaining,due.relative,description
report.waiting.labels=ID,Project,Who,Wait,Due,Description
report.waiting.filter=status:pending (+waiting or +WAITING)
report.waiting.sort=due+,wait+
report.blocked.columns=id,project,depends,due.relative,description
report.blocked.labels=ID,Project,Blocked by,Due,Description
report.blocked.filter=status:pending +BLOCKED
uda.who.type=string
uda.who.label=Who
