{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/~deepseek/deepseek-flash-latest",
  "agents": {
    "neo": {
      "description": "Neo — same base system prompt and permissions as Build, plus neo-prompt.md",
      "mode": "primary",
      "system": "{file:~/.dotfiles/config/agents/prompts/opencode-system.md}\n\n{file:~/.dotfiles/config/agents/prompts/neo-prompt.md}",
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" },
      ],
    },
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" }
  ],
  "providers": {
    "openrouter": {
      "models": {
        "~deepseek/deepseek-flash-latest": {
          "body": {
            "provider": {
              "sort": "throughput",
              "quantizations": ["fp8", "mxfp8", "fp16", "bf16", "fp32", "unknown"],
              "preferred_min_throughput": { "p50": 60 },
              "preferred_max_latency": { "p50": 1, "p90": 3 },
              "allow_fallbacks": true
            }
          }
        }
      }
    }
  },
  "warming": true
}